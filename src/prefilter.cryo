///! Prefilter: skip haystack positions where no match can start.
///!
///! An unanchored search spends most of its time where nothing is under
///! way, trying to start a match at each position in turn. A prefilter
///! answers where the next position worth trying is: the next occurrence
///! of a literal every match begins with, or failing that the next byte
///! some match can begin with. It never skips a position where a match
///! starts, so the search finds exactly what it would without one.
///!
///! A pattern that can match the empty string can match anywhere, and
///! gets no prefilter.

namespace regex::prefilter;

import std::collections::array::{ Array };
import std::ffi::libc;
import regex::automaton::{ Automaton };
import regex::syntax::tree::{ SyntaxTree };

/// How a prefilter finds candidates.
internal type enum Kind {
    /// No prefilter: every position is a candidate.
    Nothing;
    /// Every match begins with one byte; found with `memchr`.
    Byte(u8);
    /// Every match begins with `literal`, two bytes or more.
    Literal;
    /// Every match begins with a byte in `allowed`.
    ByteSet;
}

internal type struct Prefilter {
    private kind: Kind;
    private literal: Array<u8>;
    private allowed: [boolean; 256];

    /// The best prefilter for a compiled pattern.
    internal static build(tree: &SyntaxTree, automaton: &Automaton) -> Prefilter {
        mut prefilter: Prefilter = Prefilter { kind: Kind::Nothing, literal: Array::new(), allowed: [false; 256] };
        mut count: i64 = 0;
        if (!automaton.first_bytes(&prefilter.allowed)) {
            return prefilter;
        }
        for (mut byte: i64 = 0; byte < 256; byte++) {
            if (prefilter.allowed[byte]) { count = count + 1; }
        }
        // Rejecting under a fifth of the bytes does not pay for the check.
        if (count == 0 || count > 200) {
            return prefilter;
        }
        tree.literal_prefix(&prefilter.literal);
        if (prefilter.literal.length() >= 2) {
            prefilter.kind = Kind::Literal;
        } else if (count == 1) {
            for (mut byte: i64 = 0; byte < 256; byte++) {
                if (prefilter.allowed[byte]) { prefilter.kind = Kind::Byte(byte as u8); }
            }
        } else {
            prefilter.kind = Kind::ByteSet;
        }
        return prefilter;
    }

    /// The first `byte` in `[at, end)`, or `end`.
    private static find_byte(bytes: u8*, at: i64, end: i64, byte: u8) -> i64 {
        const found: void* = libc::memchr((bytes + at) as void*, byte as i32, (end - at) as u64);
        if (found == null) { return end; }
        return ((found as u64) - (bytes as u64)) as i64;
    }

    internal is_active(&this) -> boolean {
        return match (this.kind) {
            Kind::Nothing => { false }
            _ => { true }
        };
    }

    /// The first candidate position in `[at, end)`, or `end` when there is none.
    internal next_candidate(&this, bytes: u8*, at: i64, end: i64) -> i64 {
        if (at >= end) { return end; }
        match (this.kind) {
            Kind::Nothing => { return at; }
            Kind::Byte(byte) => {
                return Prefilter::find_byte(bytes, at, end, byte);
            }
            Kind::Literal => {
                const length: i64 = this.literal.length();
                const first: u8 = this.literal[0];
                mut position: i64 = at;
                while (position < end) {
                    position = Prefilter::find_byte(bytes, position, end, first);
                    if (position >= end) { return end; }
                    if (position + length > end) { return end; }
                    if (libc::memcmp((bytes + position) as void*, this.literal.as_pointer() as void*, length as u64) == 0) {
                        return position;
                    }
                    position = position + 1;
                }
                return end;
            }
            Kind::ByteSet => {
                mut position: i64 = at;
                while (position < end && !this.allowed[bytes[position] as i64]) { position = position + 1; }
                return position;
            }
        }
    }
}
