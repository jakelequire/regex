///! unicode: property lookup and case folding over the generated tables.
///!
///! A property is named the way UTS #18 and the pattern syntax allow:
///! bare (`\p{Greek}`, `\p{Lu}`, `\p{Alphabetic}`) or as `name=value`
///! (`\p{Script=Greek}`, `\p{gc:Lu}`). Names compare loosely: case,
///! spaces, underscores and hyphens are ignored, and so is a leading
///! "is" (`\p{IsGreek}`). A bare name is tried as a General_Category value,
///! then as a script (through Script_Extensions), then as a binary
///! property, which is the order UTS #18 recommends.

namespace regex::unicode;

internal module unicode::tables;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import regex::unicode::tables::{ UnicodeTables, NameIndex };
import regex::error::{ ErrorKind };

/// Unicode properties by name, and the word characters `\b` reads.
internal type struct UnicodeProperties {
    /// The table a `\p{...}` body names. `body` is the text between the
    /// braces (or the single letter of `\pL`).
    internal static table(body: Str) -> Result<&Slice<u32>, ErrorKind> {
        mut separator: i64 = -1;
        for (mut index: i64 = 0; index < body.length(); index++) {
            const byte: u8 = body.byte_at(index).unwrap();
            if (byte == 0x3D || byte == 0x3A) { // '=' or ':'
                separator = index;
                break;
            }
        }
        if (separator < 0) {
            const name: String = UnicodeProperties::normalize_name(body);
            return UnicodeProperties::bare_property(name.as_str());
        }
        const property: String = UnicodeProperties::normalize_name(body.byte_substring(0, separator));
        const value: String = UnicodeProperties::normalize_name(body.byte_substring(separator + 1, body.length()));
        const key: Str = property.as_str();
        if (key == Str::new("gc") || key == Str::new("generalcategory")) {
            return match (UnicodeProperties::find_name(NameIndex::GeneralCategory, value.as_str())) {
                Option::Some(table) => { Result::Ok(UnicodeTables::table(table)) }
                Option::None        => { Result::Err(ErrorKind::UnicodePropertyValueNotFound) }
            };
        }
        if (key == Str::new("sc") || key == Str::new("script")) {
            return match (UnicodeProperties::find_name(NameIndex::Script, value.as_str())) {
                Option::Some(script) => { Result::Ok(UnicodeTables::table(UnicodeTables::script_table(script))) }
                Option::None         => { Result::Err(ErrorKind::UnicodePropertyValueNotFound) }
            };
        }
        if (key == Str::new("scx") || key == Str::new("scriptextensions")) {
            return match (UnicodeProperties::find_name(NameIndex::Script, value.as_str())) {
                Option::Some(script) => { Result::Ok(UnicodeTables::table(UnicodeTables::script_extension_table(script))) }
                Option::None         => { Result::Err(ErrorKind::UnicodePropertyValueNotFound) }
            };
        }
        return Result::Err(ErrorKind::UnicodePropertyNotFound);
    }

    /// True when `scalar` is a word character in the sense of `\w`.
    internal static is_word_scalar(scalar: u32) -> boolean {
        // Most text is ASCII: answer it without a search.
        if (scalar < 0x80) {
            return (scalar as char).is_alphanumeric() || scalar == 0x5F;
        }
        const pairs: &Slice<u32> = UnicodeTables::word_class();
        mut low: i64 = 0;
        mut high: i64 = pairs.length() / 2;
        while (low < high) {
            const middle: i64 = low + (high - low) / 2;
            if (scalar < pairs[middle * 2]) {
                high = middle;
            } else if (scalar > pairs[middle * 2 + 1]) {
                low = middle + 1;
            } else {
                return true;
            }
        }
        return false;
    }

    /// `name` folded for comparison: ASCII lowercase, without spaces,
    /// underscores and hyphens, and without a leading "is".
    internal static normalize_name(name: Str) -> String {
        mut out: String = String::with_capacity(name.length());
        for (byte in name.as_bytes()) {
            if (byte == 0x20 || byte == 0x5F || byte == 0x2D || byte == 0x09) { continue; }
            out.push_byte(byte.to_ascii_lowercase());
        }
        const folded: Str = out.as_str();
        if (folded.length() > 2 && folded.starts_with(&Str::new("is"))) {
            return String::from_str(folded.byte_substring(2, folded.length()));
        }
        return out;
    }

    /// A name with no `=`: a General_Category value, a script, or a binary
    /// property, tried in that order.
    private static bare_property(name: Str) -> Result<&Slice<u32>, ErrorKind> {
        match (UnicodeProperties::find_name(NameIndex::GeneralCategory, name)) {
            Option::Some(table) => { return Result::Ok(UnicodeTables::table(table)); }
            Option::None => { }
        }
        match (UnicodeProperties::find_name(NameIndex::Script, name)) {
            Option::Some(script) => { return Result::Ok(UnicodeTables::table(UnicodeTables::script_extension_table(script))); }
            Option::None => { }
        }
        match (UnicodeProperties::find_name(NameIndex::Boolean, name)) {
            Option::Some(table) => { return Result::Ok(UnicodeTables::table(table)); }
            Option::None => { }
        }
        return Result::Err(ErrorKind::UnicodePropertyNotFound);
    }

    /// The entry `normalized` names in `index`, by binary search over its
    /// sorted names.
    private static find_name(index: NameIndex, normalized: Str) -> Option<i64> {
        mut low: i64 = 0;
        mut high: i64 = index.name_count();
        while (low < high) {
            const middle: i64 = low + (high - low) / 2;
            const candidate: Str = Str::new(index.name_at(middle));
            match (candidate.compare(&normalized)) {
                Ordering::Less    => { low = middle + 1; }
                Ordering::Greater => { high = middle; }
                Ordering::Equal   => { return Option::Some(index.entry_at(middle)); }
            }
        }
        return Option::None;
    }
}
