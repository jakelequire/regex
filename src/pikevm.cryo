///! PikeVM: simulates the `Nfa` over the haystack, all threads in lock step.
///!
///! Every state is visited at most once per haystack position, so a search
///! takes time proportional to the haystack's length times the
///! automaton's size, whatever the pattern - the guarantee the library is
///! built on. Threads are kept in priority order, and a match cuts every
///! thread of lower priority, which gives leftmost-first semantics: the
///! match a backtracking engine would report.
///!
///! The epsilon closure walks an explicit stack, so a deeply nested pattern
///! cannot exhaust the call stack.

namespace regex::pikevm;

import std::core::option::{ Option };
import std::collections::array::{ Array };
import std::core::mem;
import regex::nfa::{ Nfa, State, Transition };
import regex::syntax::hir::{ Look };
import regex::prefilter::{ Prefilter };
import regex::unicode;
import regex::utf8;

/// A slot no capture has written.
internal const NO_POSITION: i64 = -1;

/// A set of state ids with insertion order, cleared in constant time.
private type struct SparseSet {
    dense: Array<u32>;
    sparse: Array<u32>;
    length: i64;

    static new(capacity: i64) -> SparseSet {
        mut set: SparseSet = SparseSet { dense: Array::new(), sparse: Array::new(), length: 0 };
        set.dense.resize(capacity, 0);
        set.sparse.resize(capacity, 0);
        return set;
    }

    ![inline]
    contains(&this, id: u32) -> boolean {
        const index: u32 = this.sparse[id];
        return (index as i64) < this.length && this.dense[index] == id;
    }

    /// Add `id`; false when it was already present.
    ![inline]
    insert(mut &this, id: u32) -> boolean {
        if (this.contains(id)) { return false; }
        this.dense[this.length] = id;
        this.sparse[id] = this.length as u32;
        this.length = this.length + 1;
        return true;
    }

    clear(mut &this) -> void {
        this.length = 0;
    }
}

/// The threads at one position: their states, and each state's slots.
private type struct Threads {
    set: SparseSet;
    slots: Array<i64>;
    slots_per_state: i64;

    static new(state_count: i64, slots_per_state: i64) -> Threads {
        mut threads: Threads = Threads {
            set: SparseSet::new(state_count),
            slots: Array::new(),
            slots_per_state: slots_per_state,
        };
        threads.slots.resize(state_count * slots_per_state, NO_POSITION);
        return threads;
    }
}

/// One step of the epsilon closure's walk.
private type enum Frame {
    /// Visit a state and what it leads to without reading.
    Explore(u32);
    /// Put a slot back as it was before a capture on another path wrote it.
    RestoreCapture(u32, i64);
}

/// Scratch memory for searches with one automaton and one slot count.
/// Reusing a cache across searches avoids allocating per search.
internal type struct Cache {
    private current: Threads;
    private next: Threads;
    private stack: Array<Frame>;
    private scratch: Array<i64>;
    private slot_count: i64;
    private state_count: i64;

    internal static new(nfa: &Nfa, slot_count: i64) -> Cache {
        const states: i64 = nfa.state_count();
        mut cache: Cache = Cache {
            current: Threads::new(states, slot_count),
            next: Threads::new(states, slot_count),
            stack: Array::new(),
            scratch: Array::new(),
            slot_count: slot_count,
            state_count: states,
        };
        cache.scratch.resize(slot_count, NO_POSITION);
        return cache;
    }

    /// True when this cache was made for `nfa` with `slot_count` slots.
    internal fits(&this, nfa: &Nfa, slot_count: i64) -> boolean {
        return this.state_count == nfa.state_count() && this.slot_count == slot_count;
    }
}

/// A search of `bytes[start, end)` within the haystack `[bytes, bytes +
/// length)`; assertions see the whole haystack.
internal type struct Input {
    bytes: u8*;
    length: i64;
    start: i64;
    end: i64;
    /// Only a match beginning exactly at `start` counts.
    anchored: boolean;
    /// Stop at the first match found, whatever its length (for `is_match`).
    earliest: boolean;
}

/// Search `input` with `nfa`. On a match, answers true and fills `slots`
/// (as many as the cache was made for) with the match's capture positions.
///
/// With no thread under way, `prefilter` moves the search straight to the
/// next position where a match can start.
internal function search(nfa: &Nfa, prefilter: &Prefilter, cache: mut &Cache, input: &Input, slots: mut &Array<i64>) -> boolean {
    cache.current.set.clear();
    cache.next.set.clear();
    for (mut i: i64 = 0; i < slots.length(); i++) { slots[i] = NO_POSITION; }
    mut matched: boolean = false;
    mut at: i64 = input.start;
    loop {
        if (cache.current.set.length == 0 && (matched || (input.anchored && at > input.start))) {
            break;
        }
        if (cache.current.set.length == 0 && !matched && !input.anchored && prefilter.is_active()) {
            at = prefilter.next_candidate(input.bytes, at, input.end);
            // The prefilter is only active for patterns that cannot match
            // the empty string, so no candidate means no match.
            if (at >= input.end) { break; }
        }
        // A new thread may start here, below every thread already running.
        if (!matched && (!input.anchored || at == input.start)) {
            for (mut i: i64 = 0; i < cache.slot_count; i++) { cache.scratch[i] = NO_POSITION; }
            epsilon_closure(nfa, cache, input, at, nfa.start, true);
        }
        if (step(nfa, cache, input, at, slots)) {
            matched = true;
            if (input.earliest) { return true; }
        }
        if (at >= input.end) { break; }
        at = at + 1;
        mem::swap(&cache.current, &cache.next);
        cache.next.set.clear();
    }
    return matched;
}

/// Advance every thread at `at` over the byte there into `cache.next`.
/// Answers true when a thread matched at `at`; its slots are in `slots`,
/// and every thread of lower priority has been dropped.
private function step(nfa: &Nfa, cache: mut &Cache, input: &Input, at: i64, slots: mut &Array<i64>) -> boolean {
    mut matched: boolean = false;
    const per_state: i64 = cache.slot_count;
    const has_byte: boolean = at < input.end;
    const byte: u8 = if (has_byte) { input.bytes[at] } else { 0 };
    for (mut index: i64 = 0; index < cache.current.set.length; index++) {
        const id: u32 = cache.current.set.dense[index];
        mut next: u32 = 0;
        mut advances: boolean = false;
        match (nfa.state(id)) {
            State::ByteRange(low, high, target) => {
                if (has_byte && byte >= low && byte <= high) {
                    next = target;
                    advances = true;
                }
            }
            State::Sparse(first, count) => {
                if (has_byte) {
                    for (mut i: u32 = 0; i < count; i++) {
                        const t: Transition = nfa.transition(first + i);
                        if (byte < t.low) { break; }
                        if (byte <= t.high) {
                            next = t.next;
                            advances = true;
                            break;
                        }
                    }
                }
            }
            State::Match => {
                // A text regex matches only between whole scalars.
                if (nfa.utf8 && !utf8::is_boundary(input.bytes, input.length, at)) {
                    continue;
                }
                const base: i64 = (id as i64) * per_state;
                for (mut i: i64 = 0; i < slots.length() && i < per_state; i++) {
                    slots[i] = cache.current.slots[base + i];
                }
                matched = true;
                if (input.earliest) { return true; }
                // Every remaining thread has lower priority.
                break;
            }
            _ => { }
        }
        if (advances) {
            const base: i64 = (id as i64) * per_state;
            for (mut i: i64 = 0; i < per_state; i++) {
                cache.scratch[i] = cache.current.slots[base + i];
            }
            epsilon_closure(nfa, cache, input, at + 1, next, false);
        }
    }
    return matched;
}

/// Add `start` and everything reachable from it without reading a byte,
/// at position `at`, to `cache.current` (when `into_current`) or
/// `cache.next`, with the slots in `cache.scratch` as the thread's.
private function epsilon_closure(nfa: &Nfa, cache: mut &Cache, input: &Input, at: i64, start: u32, into_current: boolean) -> void {
    cache.stack.push(Frame::Explore(start));
    const per_state: i64 = cache.slot_count;
    while (cache.stack.length() > 0) {
        match (cache.stack.pop().unwrap()) {
            Frame::RestoreCapture(slot, value) => {
                cache.scratch[slot] = value;
            }
            Frame::Explore(first) => {
                mut id: u32 = first;
                loop {
                    const inserted: boolean = if (into_current) { cache.current.set.insert(id) } else { cache.next.set.insert(id) };
                    if (!inserted) { break; }
                    const base: i64 = (id as i64) * per_state;
                    for (mut i: i64 = 0; i < per_state; i++) {
                        if (into_current) {
                            cache.current.slots[base + i] = cache.scratch[i];
                        } else {
                            cache.next.slots[base + i] = cache.scratch[i];
                        }
                    }
                    mut proceed: boolean = false;
                    match (nfa.state(id)) {
                        State::Empty(next) => {
                            id = next;
                            proceed = true;
                        }
                        State::Look(look, next) => {
                            if (look_holds(look, input, at)) {
                                id = next;
                                proceed = true;
                            }
                        }
                        State::BinaryUnion(preferred, other) => {
                            cache.stack.push(Frame::Explore(other));
                            id = preferred;
                            proceed = true;
                        }
                        State::Union(alternates, count) => {
                            // Later alternatives wait on the stack in reverse,
                            // so they are explored in priority order.
                            mut i: u32 = count;
                            while (i > 1) {
                                i = i - 1;
                                cache.stack.push(Frame::Explore(nfa.alternate(alternates + i)));
                            }
                            id = nfa.alternate(alternates);
                            proceed = true;
                        }
                        State::Capture(slot, next) => {
                            if ((slot as i64) < per_state) {
                                cache.stack.push(Frame::RestoreCapture(slot, cache.scratch[slot]));
                                cache.scratch[slot] = at;
                            }
                            id = next;
                            proceed = true;
                        }
                        _ => { }
                    }
                    if (!proceed) { break; }
                }
            }
        }
    }
}

/// Whether `look` holds at position `at` of the input's haystack.
internal function look_holds(look: Look, input: &Input, at: i64) -> boolean {
    const bytes: u8* = input.bytes;
    const length: i64 = input.length;
    match (look) {
        Look::Start => { return at == 0; }
        Look::End => { return at == length; }
        Look::EndBeforeFinalNewline => {
            return at == length || (at == length - 1 && bytes[at] == 0x0A);
        }
        Look::StartLine => { return at == 0 || bytes[at - 1] == 0x0A; }
        Look::EndLine => { return at == length || bytes[at] == 0x0A; }
        Look::WordBoundaryAscii => {
            return is_word_byte_before(bytes, at) != is_word_byte_at(bytes, length, at);
        }
        Look::NotWordBoundaryAscii => {
            return is_word_byte_before(bytes, at) == is_word_byte_at(bytes, length, at);
        }
        Look::WordBoundaryUnicode => {
            return is_word_scalar_before(bytes, length, at) != is_word_scalar_at(bytes, length, at);
        }
        Look::NotWordBoundaryUnicode => {
            return is_word_scalar_before(bytes, length, at) == is_word_scalar_at(bytes, length, at);
        }
    }
}

private function is_word_byte(byte: u8) -> boolean {
    return byte.is_alpha() || byte.is_digit() || byte == 0x5F;
}

private function is_word_byte_before(bytes: u8*, at: i64) -> boolean {
    return at > 0 && is_word_byte(bytes[at - 1]);
}

private function is_word_byte_at(bytes: u8*, length: i64, at: i64) -> boolean {
    return at < length && is_word_byte(bytes[at]);
}

private function is_word_scalar_before(bytes: u8*, length: i64, at: i64) -> boolean {
    return match (utf8::decode_before(bytes, length, at)) {
        Option::Some(scalar) => { unicode::is_word_scalar(scalar) }
        Option::None => { false }
    };
}

private function is_word_scalar_at(bytes: u8*, length: i64, at: i64) -> boolean {
    return match (utf8::decode_at(bytes, length, at)) {
        Option::Some(scalar) => { unicode::is_word_scalar(scalar) }
        Option::None => { false }
    };
}
