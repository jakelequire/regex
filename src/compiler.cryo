///! Compiler: `SyntaxTree` to `Automaton` by Thompson's construction.
///!
///! Each node compiles to a fragment: a start state and an end state whose
///! successor is still a `HOLE`, to be patched to whatever follows. A
///! counted repetition compiles its operand once per copy it needs.
///!
///! A Unicode class becomes byte transitions through its UTF-8 sequences.
///! They are added in ascending order to a trie whose finished nodes are
///! shared by value, so equal suffixes - the continuation bytes most
///! sequences end in - are compiled once: the result is the minimal
///! acyclic automaton for the class.

namespace regex::compiler;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::core::hash::{ FnvHasher, Hasher };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::collections::str::{ Str };
import regex::error::{ Error, ErrorKind };
import regex::automaton::{ Automaton, State, Transition, HOLE };
import regex::syntax::tree::{ SyntaxTree, SyntaxNode, SyntaxClass, UNBOUNDED };
import regex::syntax::intervals::{ ClassRanges, Interval };
import regex::utf8::{ Utf8Sequence };

/// A compiled part of the pattern: entered at `start`, left through the
/// hole of `end`.
private type struct Fragment {
    start: u32;
    end: u32;
}

/// A step of the compiler's walk over the tree.
private type enum Task {
    /// Compile a node: a leaf at once, an inner node by first scheduling
    /// its `Build` and then its children.
    Visit(u32);
    /// Join the fragments the node's children left on the value stack.
    Build(u32);
}

internal type struct Compiler {
    private automaton: Automaton;
    private size_limit: i64;
    private pattern: Str;
    /// For each node, whether it can match the empty string.
    private matches_empty: Array<boolean>;

    /// Compile `tree` with `slot_count` capture slots. `utf8_only` marks a
    /// text regex. `size_limit` bounds the automaton's memory, in bytes.
    internal static compile(tree: &SyntaxTree, slot_count: u32, utf8_only: boolean, size_limit: i64, pattern: Str) -> Result<Automaton, Error> {
        mut compiler: Compiler = Compiler {
            automaton: Automaton {
                states: Array::new(),
                transitions: Array::new(),
                alternates: Array::new(),
                start: 0,
                slot_count: slot_count,
                utf8_only: utf8_only,
            },
            size_limit: size_limit,
            pattern: pattern,
            matches_empty: tree.nodes_matching_empty(),
        };
        const body: Fragment = compiler.compile_tree(tree)?;
        const done: u32 = compiler.add(State::Match)?;
        compiler.patch(body.end, done);
        compiler.automaton.start = body.start;
        compiler.collapse_empty_chains();
        return Result::Ok(compiler.finish());
    }

    /// How many compiled copies of its operand a repetition needs: one for
    /// a loop with no required copy, `min` for one with (the last copy
    /// loops), and `max` for a bounded one.
    private static repetition_copies(min: u32, max: u32) -> u32 {
        if (max == UNBOUNDED) {
            return if (min == 0) { 1 } else { min };
        }
        return max;
    }

    private finish(mut this) -> Automaton {
        const { automaton, size_limit, pattern, matches_empty }: Compiler = this;
        return automaton;
    }

    private too_big(&this) -> Error {
        return Error::new(ErrorKind::SizeLimitExceeded, this.pattern, 0, this.pattern.length());
    }

    private add(mut &this, state: State) -> Result<u32, Error> {
        this.automaton.states.push(state);
        if (this.automaton.memory_usage() > this.size_limit) {
            return Result::Err(this.too_big());
        }
        return Result::Ok((this.automaton.states.length() - 1) as u32);
    }

    /// Fill the hole of `from` with `to`. A binary union's hole is
    /// whichever successor is still a hole.
    private patch(mut &this, from: u32, to: u32) -> void {
        const replacement: State = match (this.automaton.states[from]) {
            State::Empty(_)                   => { State::Empty(to) }
            State::ByteRange(low, high, _)    => { State::ByteRange(low, high, to) }
            State::Capture(slot, _)           => { State::Capture(slot, to) }
            State::Assertion(assertion, _)    => { State::Assertion(assertion, to) }
            State::BinaryUnion(first, second) => {
                first == HOLE ? State::BinaryUnion(to, second) : State::BinaryUnion(first, to)
            }
            other => { other }
        };
        this.automaton.states[from] = replacement;
    }

    private empty(mut &this) -> Result<Fragment, Error> {
        const id: u32 = this.add(State::Empty(HOLE))?;
        return Result::Ok(Fragment { start: id, end: id });
    }

    /// The fragment for the whole tree. The walk keeps its own stacks - of
    /// tasks, and of the fragments compiled children leave - instead of
    /// recursing, so no nesting depth can exhaust the call stack.
    private compile_tree(mut &this, tree: &SyntaxTree) -> Result<Fragment, Error> {
        mut tasks: Array<Task> = Array::new();
        mut values: Array<Fragment> = Array::new();
        tasks.push(Task::Visit(tree.root()));
        while (tasks.length() > 0) {
            match (tasks.pop().unwrap()) {
                Task::Visit(id) => {
                    match (tree.node(id)) {
                        SyntaxNode::Empty => { values.push(this.empty()?); }
                        SyntaxNode::Literal(start, length) => {
                            values.push(this.compile_literal(tree.literal(start, length))?);
                        }
                        SyntaxNode::Class(index) => {
                            const payload: SyntaxClass* = tree.class(index);
                            if (payload.bytes) {
                                values.push(this.compile_byte_class(&payload.ranges)?);
                            } else {
                                values.push(this.compile_scalar_class(&payload.ranges)?);
                            }
                        }
                        SyntaxNode::Assertion(assertion) => {
                            const state: u32 = this.add(State::Assertion(assertion, HOLE))?;
                            values.push(Fragment { start: state, end: state });
                        }
                        SyntaxNode::Capture(_, sub) => {
                            tasks.push(Task::Build(id));
                            tasks.push(Task::Visit(sub));
                        }
                        SyntaxNode::Concatenation(first, count) => {
                            tasks.push(Task::Build(id));
                            this.schedule_children(tree, first, count, &tasks);
                        }
                        SyntaxNode::Alternation(first, count) => {
                            tasks.push(Task::Build(id));
                            this.schedule_children(tree, first, count, &tasks);
                        }
                        SyntaxNode::Repetition(min, max, _, sub) => {
                            tasks.push(Task::Build(id));
                            const copies: u32 = Compiler::repetition_copies(min, max);
                            for (mut i: u32 = 0; i < copies; i++) { tasks.push(Task::Visit(sub)); }
                        }
                    }
                }
                Task::Build(id) => {
                    mut taken: i64 = 0;
                    mut built: Fragment = Fragment { start: 0, end: 0 };
                    match (tree.node(id)) {
                        SyntaxNode::Capture(index, _) => {
                            taken = 1;
                            const body: Fragment = values[values.length() - 1];
                            const open: u32 = this.add(State::Capture(index * 2, HOLE))?;
                            const close: u32 = this.add(State::Capture(index * 2 + 1, HOLE))?;
                            this.patch(open, body.start);
                            this.patch(body.end, close);
                            built = Fragment { start: open, end: close };
                        }
                        SyntaxNode::Concatenation(_, count) => {
                            taken = count as i64;
                            built = this.build_concatenation(values.as_slice().subslice(values.length() - taken, values.length()));
                        }
                        SyntaxNode::Alternation(_, count) => {
                            taken = count as i64;
                            built = this.build_alternation(values.as_slice().subslice(values.length() - taken, values.length()))?;
                        }
                        SyntaxNode::Repetition(min, max, greedy, sub) => {
                            taken = Compiler::repetition_copies(min, max) as i64;
                            const copies: &Slice<Fragment> = values.as_slice().subslice(values.length() - taken, values.length());
                            built = this.build_repetition(copies, min, max, greedy, this.matches_empty[sub])?;
                        }
                        _ => { }
                    }
                    values.truncate(values.length() - taken);
                    values.push(built);
                }
            }
        }
        return Result::Ok(values.pop().unwrap());
    }

    /// Visit tasks for `children[first .. first + count]`, so that they are
    /// compiled - and their fragments stacked - in order.
    private schedule_children(&this, tree: &SyntaxTree, first: u32, count: u32, tasks: mut &Array<Task>) -> void {
        mut i: u32 = count;
        while (i > 0) {
            i = i - 1;
            tasks.push(Task::Visit(tree.child(first, i)));
        }
    }

    private compile_literal(mut &this, bytes: &Slice<u8>) -> Result<Fragment, Error> {
        const first: u32 = this.add(State::ByteRange(bytes[0], bytes[0], HOLE))?;
        mut last: u32 = first;
        for (mut i: i64 = 1; i < bytes.length(); i++) {
            const next: u32 = this.add(State::ByteRange(bytes[i], bytes[i], HOLE))?;
            this.patch(last, next);
            last = next;
        }
        return Result::Ok(Fragment { start: first, end: last });
    }

    private build_concatenation(mut &this, parts: &Slice<Fragment>) -> Fragment {
        mut whole: Fragment = parts[0];
        for (mut i: i64 = 1; i < parts.length(); i++) {
            this.patch(whole.end, parts[i].start);
            whole.end = parts[i].end;
        }
        return whole;
    }

    private build_alternation(mut &this, branches: &Slice<Fragment>) -> Result<Fragment, Error> {
        const join: u32 = this.add(State::Empty(HOLE))?;
        const alternates_start: u32 = this.automaton.alternates.length() as u32;
        for (branch in branches) {
            this.patch(branch.end, join);
            this.automaton.alternates.push(branch.start);
        }
        const union: u32 = this.add(State::Union(alternates_start, branches.length() as u32))?;
        return Result::Ok(Fragment { start: union, end: join });
    }

    /// A split that prefers `preferred` when greedy, the hole otherwise.
    private split(mut &this, greedy: boolean, preferred: u32) -> Result<u32, Error> {
        if (greedy) {
            return this.add(State::BinaryUnion(preferred, HOLE));
        }
        return this.add(State::BinaryUnion(HOLE, preferred));
    }

    /// Join the compiled copies of a repetition's operand, as many as
    /// `repetition_copies` asks for. `operand_matches_empty` says the
    /// operand can match the empty string.
    private build_repetition(mut &this, copies: &Slice<Fragment>, min: u32, max: u32, greedy: boolean, operand_matches_empty: boolean) -> Result<Fragment, Error> {
        if (max == UNBOUNDED && min == 0) {
            const body: Fragment = copies[0];
            const loop_split: u32 = this.split(greedy, body.start)?;
            this.patch(body.end, loop_split);
            if (!operand_matches_empty) {
                // `x*`.
                return Result::Ok(Fragment { start: loop_split, end: loop_split });
            }
            // `x*` where `x` can match empty is compiled as `(x+)?`. As a
            // plain loop, the empty pass through `x` returns to the loop's
            // own split, which this position has already visited, and dies
            // there - leaving a lower-priority path that reads more to win.
            // Through `(x+)?` the empty pass reaches the exit first, as a
            // backtracking engine would take it.
            const optional: u32 = this.split(greedy, body.start)?;
            const exit: u32 = this.add(State::Empty(HOLE))?;
            this.patch(loop_split, exit);
            this.patch(optional, exit);
            return Result::Ok(Fragment { start: optional, end: exit });
        }
        // The required copies, in sequence.
        mut whole: Fragment = this.empty()?;
        for (mut i: u32 = 0; i < min; i++) {
            const body: Fragment = copies[i as i64];
            this.patch(whole.end, body.start);
            whole.end = body.end;
        }
        if (max == UNBOUNDED) {
            // `x{n,}` is `x{n-1}x+`: the last required copy loops.
            const last: Fragment = copies[(min - 1) as i64];
            const loop_split: u32 = this.split(greedy, last.start)?;
            this.patch(last.end, loop_split);
            whole.end = loop_split;
            return Result::Ok(whole);
        }
        // `max - min` optional copies, each able to skip to the end.
        const exit: u32 = this.add(State::Empty(HOLE))?;
        for (mut i: u32 = min; i < max; i++) {
            const body: Fragment = copies[i as i64];
            const optional: u32 = this.split(greedy, body.start)?;
            this.patch(whole.end, optional);
            this.patch(optional, exit);
            whole.end = body.end;
        }
        this.patch(whole.end, exit);
        whole.end = exit;
        return Result::Ok(whole);
    }

    /// A class over bytes: one state reading any byte of the set.
    private compile_byte_class(mut &this, ranges: &ClassRanges) -> Result<Fragment, Error> {
        const join: u32 = this.add(State::Empty(HOLE))?;
        if (ranges.is_empty()) {
            const fail: u32 = this.add(State::Fail)?;
            return Result::Ok(Fragment { start: fail, end: join });
        }
        if (ranges.length() == 1) {
            const only: Interval = ranges.get(0);
            const state: u32 = this.add(State::ByteRange(only.start as u8, only.end as u8, join))?;
            return Result::Ok(Fragment { start: state, end: join });
        }
        const first: u32 = this.automaton.transitions.length() as u32;
        for (interval in ranges.as_slice()) {
            this.automaton.transitions.push(Transition { low: interval.start as u8, high: interval.end as u8, next: join });
        }
        const state: u32 = this.add(State::Sparse(first, ranges.length() as u32))?;
        return Result::Ok(Fragment { start: state, end: join });
    }

    /// A class over scalars: the minimal byte automaton of its UTF-8
    /// sequences, all ending in one join state.
    private compile_scalar_class(mut &this, ranges: &ClassRanges) -> Result<Fragment, Error> {
        const join: u32 = this.add(State::Empty(HOLE))?;
        if (ranges.is_empty()) {
            const fail: u32 = this.add(State::Fail)?;
            return Result::Ok(Fragment { start: fail, end: join });
        }
        mut builder: Utf8Builder = Utf8Builder::new(join);
        mut sequences: Array<Utf8Sequence> = Array::new();
        for (interval in ranges.as_slice()) {
            sequences.clear();
            Utf8Sequence::for_range(interval.start, interval.end, &sequences);
            for (sequence in sequences) {
                builder.add(this, &sequence)?;
            }
        }
        const root: u32 = builder.finish(this)?;
        return Result::Ok(Fragment { start: root, end: join });
    }

    /// The state reading `transitions`, reusing an identical one already
    /// built for this class.
    private state_for(mut &this, transitions: &Slice<Transition>, cache: mut &HashMap<u64, u32>) -> Result<u32, Error> {
        mut hasher: FnvHasher = FnvHasher::new();
        for (transition in transitions) {
            hasher.write_unsigned_integer(transition.low as u128, 1);
            hasher.write_unsigned_integer(transition.high as u128, 1);
            hasher.write_unsigned_integer(transition.next as u128, 4);
        }
        const key: u64 = hasher.finish();
        match (cache.get(&key)) {
            Option::Some(existing) => {
                if (this.reads_exactly(existing, transitions)) { return Result::Ok(existing); }
            }
            Option::None => { }
        }
        mut state: u32 = 0;
        if (transitions.length() == 1) {
            const only: Transition = transitions[0];
            state = this.add(State::ByteRange(only.low, only.high, only.next))?;
        } else {
            const first: u32 = this.automaton.transitions.length() as u32;
            this.automaton.transitions.append(transitions);
            state = this.add(State::Sparse(first, transitions.length() as u32))?;
        }
        cache.insert(key, state);
        return Result::Ok(state);
    }

    /// True when state `id` reads exactly `transitions`.
    private reads_exactly(&this, id: u32, transitions: &Slice<Transition>) -> boolean {
        match (this.automaton.states[id]) {
            State::ByteRange(low, high, next) => {
                if (transitions.length() != 1) { return false; }
                const only: Transition = transitions[0];
                return only.low == low && only.high == high && only.next == next;
            }
            State::Sparse(first, count) => {
                if (transitions.length() != count as i64) { return false; }
                for (mut i: u32 = 0; i < count; i++) {
                    const built: Transition = this.automaton.transitions[first + i];
                    const wanted: Transition = transitions[i as i64];
                    if (built.low != wanted.low || built.high != wanted.high || built.next != wanted.next) { return false; }
                }
                return true;
            }
            _ => { return false; }
        }
    }

    /// Replace every successor that is an `Empty` state by where its chain
    /// of `Empty` states leads, so the matchers step over fewer states.
    /// The `Empty` states themselves stay, unreferenced.
    private collapse_empty_chains(mut &this) -> void {
        const count: i64 = this.automaton.states.length();
        for (mut id: i64 = 0; id < count; id++) {
            const replacement: State = match (this.automaton.states[id]) {
                State::Empty(next)                => { State::Empty(this.resolve(next)) }
                State::ByteRange(low, high, next) => { State::ByteRange(low, high, this.resolve(next)) }
                State::BinaryUnion(first, second) => { State::BinaryUnion(this.resolve(first), this.resolve(second)) }
                State::Capture(slot, next)        => { State::Capture(slot, this.resolve(next)) }
                State::Assertion(assertion, next) => { State::Assertion(assertion, this.resolve(next)) }
                other => { other }
            };
            this.automaton.states[id] = replacement;
        }
        for (mut i: i64 = 0; i < this.automaton.transitions.length(); i++) {
            const transition: Transition = this.automaton.transitions[i];
            this.automaton.transitions[i] = Transition { low: transition.low, high: transition.high, next: this.resolve(transition.next) };
        }
        for (mut i: i64 = 0; i < this.automaton.alternates.length(); i++) {
            this.automaton.alternates[i] = this.resolve(this.automaton.alternates[i]);
        }
        this.automaton.start = this.resolve(this.automaton.start);
    }

    /// Where a chain of `Empty` states starting at `id` leads. A chain
    /// that loops back on itself (an empty loop) resolves to where the
    /// walk noticed, which is still a state on the chain.
    private resolve(&this, id: u32) -> u32 {
        mut current: u32 = id;
        mut steps: i64 = 0;
        const limit: i64 = this.automaton.states.length();
        while (steps < limit) {
            match (this.automaton.states[current]) {
                State::Empty(next) => {
                    if (next == HOLE) { return current; }
                    current = next;
                }
                _ => { return current; }
            }
            steps = steps + 1;
        }
        return current;
    }
}

/// Builds the byte automaton of one scalar class from its UTF-8
/// sequences, added in ascending order.
///
/// The trie under construction is kept as the path of its unfinished
/// nodes: level `k` holds the transitions of the node at depth `k`, the
/// last of which (for every level but the deepest) leads to the node one
/// level down and is still `HOLE`. Adding a sequence finishes every level
/// below the prefix it shares with the previous one; a finished node is
/// compiled through the class's cache, which is what shares suffixes.
private type struct Utf8Builder {
    target: u32;
    levels: Array<i64>;
    pool: Array<Transition>;
    cache: HashMap<u64, u32>;

    static new(target: u32) -> Utf8Builder {
        mut builder: Utf8Builder = Utf8Builder {
            target: target,
            levels: Array::new(),
            pool: Array::new(),
            cache: HashMap::new(),
        };
        builder.levels.push(0);
        return builder;
    }

    add(mut &this, compiler: mut &Compiler, sequence: &Utf8Sequence) -> Result<(), Error> {
        // The shared prefix: levels whose pending transition reads the
        // same range this sequence does at that position.
        mut prefix: i64 = 0;
        while (prefix + 1 < sequence.length && prefix + 1 < this.levels.length()) {
            const last: Transition = this.pool[this.level_end(prefix) - 1];
            if (last.low != sequence.low[prefix] || last.high != sequence.high[prefix] || last.next != HOLE) {
                break;
            }
            prefix = prefix + 1;
        }
        this.finish_below(compiler, prefix)?;
        for (mut i: i64 = prefix; i < sequence.length; i++) {
            const last_byte: boolean = i + 1 == sequence.length;
            const next: u32 = if (last_byte) { this.target } else { HOLE };
            this.pool.push(Transition { low: sequence.low[i], high: sequence.high[i], next: next });
            if (!last_byte) {
                this.levels.push(this.pool.length());
            }
        }
        return Result::Ok(());
    }

    /// One past the last transition of level `level`.
    level_end(&this, level: i64) -> i64 {
        if (level + 1 < this.levels.length()) { return this.levels[level + 1]; }
        return this.pool.length();
    }

    /// Compile every level deeper than `keep`, deepest first, patching
    /// each into its parent's pending transition.
    finish_below(mut &this, compiler: mut &Compiler, keep: i64) -> Result<(), Error> {
        while (this.levels.length() - 1 > keep) {
            const top: i64 = this.levels.length() - 1;
            const start: i64 = this.levels[top];
            const state: u32 = compiler.state_for(this.pool.as_slice().subslice(start, this.pool.length()), &this.cache)?;
            this.pool.truncate(start);
            this.levels.pop();
            const parent_last: i64 = this.pool.length() - 1;
            const pending: Transition = this.pool[parent_last];
            this.pool[parent_last] = Transition { low: pending.low, high: pending.high, next: state };
        }
        return Result::Ok(());
    }

    /// Finish the whole trie; answers the root's state.
    finish(mut &this, compiler: mut &Compiler) -> Result<u32, Error> {
        this.finish_below(compiler, 0)?;
        return compiler.state_for(this.pool.as_slice(), &this.cache);
    }
}
