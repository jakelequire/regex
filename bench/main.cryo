///! Throughput benchmarks: `cryo build`, then `build/regex-bench`.
///!
///! Each case runs a search over a 2 MiB haystack (or many short ones)
///! several times and reports the best run, in MiB/s of haystack scanned.

namespace Bench;

import regex::{ Regex, RegexBuilder };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::time::clock::{ Instant };
import std::time::duration::{ Duration };
import std::fmt;

/// The benchmark cases and their haystack.
type struct Benchmark {
    /// A deterministic English-like haystack of about `size` bytes, with a
    /// sprinkling of e-mail addresses, numbers and Greek words.
    static haystack(size: i64) -> String {
        const words: [string; 24] = [
            "the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog",
            "Sherlock", "Holmes", "watched", "carefully", "as", "the", "rain",
            "fell", "on", "Baker", "Street", "and", "nothing", "moved", "at", "all",
        ];
        mut out: String = String::with_capacity(size + 64);
        mut state: u64 = 0x9E3779B97F4A7C15;
        mut count: i64 = 0;
        while (out.length() < size) {
            state = state.wrapping_multiply(6364136223846793005).wrapping_add(1442695040888963407);
            const pick: i64 = ((state >> 33) % 24) as i64;
            out.push(Str::new(words[pick]));
            count = count + 1;
            if (count % 97 == 0) { out.push(Str::new(" someone@example.com")); }
            if (count % 53 == 0) { out.push(Str::new(" 2026-11-02")); }
            if (count % 211 == 0) { out.push(Str::new(" \u{3b1}\u{3bb}\u{3c6}\u{3b1}")); }
            out.push_byte(if (count % 13 == 0) { 0x0A as u8 } else { 0x20 as u8 });
        }
        return out;
    }

    /// Best of `rounds` runs of counting the matches of `pattern` in `text`.
    static find_all(name: string, pattern: string, text: Str, rounds: i64) -> void {
        const expression: Regex = Regex::new(Str::new(pattern)).unwrap();
        mut best: u64 = 0xFFFFFFFFFFFFFFFF;
        mut matches: i64 = 0;
        for (mut round: i64 = 0; round < rounds; round++) {
            const start: Instant = Instant::now();
            mut count: i64 = 0;
            for (found in expression.find_all(text)) { count = count + 1; }
            const nanoseconds: u64 = start.elapsed().as_nanoseconds();
            if (nanoseconds < best) { best = nanoseconds; }
            matches = count;
        }
        Benchmark::report(name, text.length(), best, matches);
    }

    /// Best of `rounds` runs of many `is_match` calls on one short subject.
    static is_match_short(name: string, pattern: string, rounds: i64) -> void {
        const expression: Regex = Regex::new(Str::new(pattern)).unwrap();
        const subject: Str = Str::new("user-1234@example.com");
        const calls: i64 = 100000;
        mut best: u64 = 0xFFFFFFFFFFFFFFFF;
        mut hits: i64 = 0;
        for (mut round: i64 = 0; round < rounds; round++) {
            const start: Instant = Instant::now();
            mut count: i64 = 0;
            for (mut call: i64 = 0; call < calls; call++) {
                if (expression.is_match(subject)) { count = count + 1; }
            }
            const nanoseconds: u64 = start.elapsed().as_nanoseconds();
            if (nanoseconds < best) { best = nanoseconds; }
            hits = count;
        }
        const per_call: u64 = best / (calls as u64);
        fmt::println(f"{name:<34} {per_call:>8} ns/call   ({hits} hits)");
    }

    static report(name: string, bytes: i64, nanoseconds: u64, matches: i64) -> void {
        const mebibytes: f64 = (bytes as f64) / (1024.0 * 1024.0);
        const seconds: f64 = (nanoseconds as f64) / 1000000000.0;
        const throughput: f64 = mebibytes / seconds;
        fmt::println(f"{name:<34} {throughput:>8.1} MiB/s   ({matches} matches)");
    }
}

function main() -> i32 {
    const text: String = Benchmark::haystack(2 * 1024 * 1024);
    const view: Str = text.as_str();
    fmt::println(f"haystack: {view.length()} bytes");
    Benchmark::find_all("literal: Sherlock", "Sherlock", view, 3);
    Benchmark::find_all("literal, rare: Moriarty", "Moriarty", view, 3);
    Benchmark::find_all("alternation: Sherlock|Holmes", "Sherlock|Holmes", view, 3);
    Benchmark::find_all("email: \\w+@\\w+\\.com", "\\w+@\\w+\\.com", view, 3);
    Benchmark::find_all("date: \\d{4}-\\d{2}-\\d{2}", "\\d{4}-\\d{2}-\\d{2}", view, 3);
    Benchmark::find_all("words: \\b\\w+\\b", "\\b\\w+\\b", view, 3);
    Benchmark::find_all("unicode: \\p{Greek}+", "\\p{Greek}+", view, 3);
    Benchmark::find_all("suffix: [a-z]+ing", "[a-z]+ing", view, 3);
    Benchmark::is_match_short("is_match short: @\\w+\\.com$", "@\\w+\\.com$", 3);
    return 0;
}
