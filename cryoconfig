[project]
project_name = "regex"
output_dir   = "build"
# The demo program and tests/ import the library through its source root.
source_paths = ["src"]

# The library a dependent project compiles: src/lib.cryo declares the
# namespace `regex`, and every file under src/ lies below it. Its version is
# the repository's tag (v0.1.0, ...), not a key here.
[lib]
name       = "regex"
source_dir = "src"

# `cryo test` needs an executable target; the demo is that target.
[[bin]]
name        = "regex-demo"
entry_point = "examples/demo.cryo"

[[bin]]
name        = "regex-bench"
entry_point = "bench/main.cryo"

[dependencies]
