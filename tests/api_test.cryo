///! The public surface: captures, named groups, replacement, splitting,
///! escaping and the builder's options.

![config(testing)]
namespace RegexTests::Api;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::assert::{ expect, expect_equal };
import std::test::error::{ TestError };
import regex::{ Regex, RegexBuilder, Match, Captures };

![test]
function groups_that_did_not_take_part_have_no_span() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("(a)|(b)")).unwrap();
    const captures: Captures = expression.captures(Str::new("b")).unwrap();
    expect_equal(captures.length(), 3 as i64)?;
    expect(captures.get(1).is_none(), "group 1 did not take part")?;
    expect_equal(captures.get(2).unwrap().as_str(), Str::new("b"))?;
    return expect(captures.get(3).is_none(), "no group 3");
}

![test]
function a_repeated_group_keeps_its_last_iteration() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("(\\w)+")).unwrap();
    const captures: Captures = expression.captures(Str::new("abc")).unwrap();
    return expect_equal(captures.get(1).unwrap().as_str(), Str::new("c"));
}

![test]
function named_groups_are_reached_by_name_and_number() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("(?<year>\\d{4})-(?P<month>\\d\\d)-(?'day'\\d\\d)")).unwrap();
    const captures: Captures = expression.captures(Str::new("on 2026-11-02.")).unwrap();
    expect_equal(captures.name(Str::new("year")).unwrap().as_str(), Str::new("2026"))?;
    expect_equal(captures.name(Str::new("month")).unwrap().as_str(), Str::new("11"))?;
    expect_equal(captures.get(3).unwrap().as_str(), Str::new("02"))?;
    expect(captures.name(Str::new("hour")).is_none(), "no such group")?;
    expect_equal(expression.captures_length(), 4 as i64)?;
    expect_equal(expression.capture_name(1).unwrap(), Str::new("year"))?;
    expect(expression.capture_name(0).is_none(), "group 0 has no name")?;
    return expect_equal(expression.capture_index(Str::new("day")).unwrap(), 3 as i64);
}

![test]
function captures_all_yields_every_match() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("(\\w+)=(\\d+)")).unwrap();
    mut keys: String = String::new();
    mut total: i64 = 0;
    for (captures in expression.captures_all(Str::new("a=1, bb=22, c=x, ddd=333"))) {
        keys.push(captures.get(1).unwrap().as_str());
        total = total + i64::try_from(captures.get(2).unwrap().as_str()).unwrap();
    }
    expect_equal(keys.as_str(), Str::new("abbddd"))?;
    return expect_equal(total, 356 as i64);
}

![test]
function find_at_sees_the_whole_haystack() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("\\bb")).unwrap();
    // At 1 there is no word boundary: `a` comes before it.
    expect(expression.find_at(Str::new("ab b"), 1).unwrap().start() == 3, "boundary at 3 only")?;
    const anchored: Regex = Regex::new(Str::new("^b")).unwrap();
    return expect(anchored.find_at(Str::new("ab"), 1).is_none(), "^ is the haystack's start");
}

![test]
function replace_expands_references() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("(?<user>\\w+)@(\\w+)")).unwrap();
    expect_equal(expression.replace_all(Str::new("x@y and a@b"), Str::new("$2 at $1")).as_str(), Str::new("y at x and b at a"))?;
    expect_equal(expression.replace(Str::new("x@y and a@b"), Str::new("${user}!")).as_str(), Str::new("x! and a@b"))?;
    expect_equal(expression.replace_all(Str::new("x@y"), Str::new("$$1")).as_str(), Str::new("$1"))?;
    // A reference starting with a digit takes only digits.
    expect_equal(expression.replace_all(Str::new("x@y"), Str::new("$1a")).as_str(), Str::new("xa"))?;
    // Unknown and non-participating groups expand to nothing.
    expect_equal(expression.replace_all(Str::new("x@y"), Str::new("[$9][$nope]")).as_str(), Str::new("[][]"))?;
    // A `$` starting no reference is itself.
    expect_equal(expression.replace_all(Str::new("x@y"), Str::new("$ ${} $")).as_str(), Str::new("$ ${} $"))?;
    return expect_equal(expression.replace_at_most(Str::new("a@b c@d e@f"), 2, Str::new("_")).as_str(), Str::new("_ _ e@f"));
}

![test]
function replace_all_with_empty_matches() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("x*")).unwrap();
    return expect_equal(expression.replace_all(Str::new("abxd"), Str::new("-")).as_str(), Str::new("-a-b-d-"));
}

![test]
function split_yields_the_text_between_matches() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new(",")).unwrap();
    mut pieces: String = String::new();
    for (piece in expression.split(Str::new("a,b,,c,"))) {
        pieces.push(piece);
        pieces.push_byte(0x7C);
    }
    expect_equal(pieces.as_str(), Str::new("a|b||c||"))?;
    mut limited: String = String::new();
    for (piece in expression.split_at_most(Str::new("a,b,,c,"), 2)) {
        limited.push(piece);
        limited.push_byte(0x7C);
    }
    expect_equal(limited.as_str(), Str::new("a|b,,c,|"))?;
    mut none: i64 = 0;
    for (piece in expression.split_at_most(Str::new("a,b"), 0)) { none = none + 1; }
    return expect_equal(none, 0 as i64);
}

![test]
function split_on_whitespace_runs() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("\\s+")).unwrap();
    mut pieces: String = String::new();
    for (piece in expression.split(Str::new("  one two\t\nthree "))) {
        pieces.push(piece);
        pieces.push_byte(0x7C);
    }
    return expect_equal(pieces.as_str(), Str::new("|one|two|three||"));
}

![test]
function escape_makes_any_text_literal() -> Result<(), TestError> {
    const raw: Str = Str::new("1.5*(x+y) [a-z]{2} ^$|?\\ #~&");
    const escaped: String = Regex::escape(raw);
    const expression: Regex = Regex::new(escaped.as_str()).unwrap();
    const found: Match = expression.find(raw).unwrap();
    expect_equal(found.start(), 0 as i64)?;
    expect_equal(found.end(), raw.length())?;
    // Verbose mode would otherwise eat the escaped space and `#`.
    const verbose: Regex = RegexBuilder::new(escaped.as_str()).ignore_whitespace(true).build().unwrap();
    return expect(verbose.is_match(raw), "escaped text survives verbose mode");
}

![test]
function builder_flags_match_inline_flags() -> Result<(), TestError> {
    const insensitive: Regex = RegexBuilder::new(Str::new("abc")).case_insensitive(true).build().unwrap();
    expect(insensitive.is_match(Str::new("ABC")), "case_insensitive")?;
    const lines: Regex = RegexBuilder::new(Str::new("^b$")).multi_line(true).build().unwrap();
    expect(lines.is_match(Str::new("a\nb\nc")), "multi_line")?;
    const dot: Regex = RegexBuilder::new(Str::new("a.b")).dot_matches_new_line(true).build().unwrap();
    expect(dot.is_match(Str::new("a\nb")), "dot_matches_new_line")?;
    const lazy: Regex = RegexBuilder::new(Str::new("a+")).swap_greed(true).build().unwrap();
    expect_equal(lazy.find(Str::new("aaa")).unwrap().end(), 1 as i64)?;
    const ascii: Regex = RegexBuilder::new(Str::new("\\w+")).unicode(false).build().unwrap();
    expect_equal(ascii.find(Str::new("\u{e9}t\u{e9}")).unwrap().as_str(), Str::new("t"))?;
    // An inline flag overrides the builder's for its scope.
    const scoped: Regex = RegexBuilder::new(Str::new("a(?-i:b)")).case_insensitive(true).build().unwrap();
    expect(scoped.is_match(Str::new("Ab")), "inline flag wins")?;
    return expect(!scoped.is_match(Str::new("AB")), "inline flag wins inside its group");
}

![test]
function is_match_and_find_agree() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("[0-9]+\\.[0-9]+")).unwrap();
    expect(expression.is_match(Str::new("pi is 3.14")), "is_match")?;
    expect(!expression.is_match(Str::new("no number")), "no match")?;
    expect(expression.is_match_at(Str::new("3.14 x"), 0), "is_match_at 0")?;
    return expect(!expression.is_match_at(Str::new("3.14 x"), 2), "is_match_at past the only match");
}

![test]
function regex_displays_its_pattern() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("a+b")).unwrap();
    expect_equal(expression.as_str(), Str::new("a+b"))?;
    const shown: String = f"{expression}";
    return expect_equal(shown.as_str(), Str::new("a+b"));
}

![test]
function one_regex_serves_nested_searches() -> Result<(), TestError> {
    // A search while an iteration over the same regex is under way: each
    // search must get scratch memory of its own.
    const expression: Regex = Regex::new(Str::new("\\d+")).unwrap();
    mut sum: i64 = 0;
    for (outer in expression.find_all(Str::new("1 22 333"))) {
        for (inner in expression.find_all(outer.as_str())) {
            sum = sum + inner.length();
        }
        expect(expression.is_match(outer.as_str()), "nested is_match")?;
    }
    return expect_equal(sum, 6 as i64);
}
