///! The differential cases (see differential_cases.cryo): every case's
///! first match and group spans must be what the generator's reference
///! engine reported.

![config(testing)]
namespace RegexTests::Differential;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::assert::{ bail };
import std::test::error::{ TestError };
import regex::{ Regex, Captures, Match };
import RegexTests::DifferentialCases::{ CASES, CASE_COUNT, Case };

![test]
function matches_reference_engine() -> Result<(), TestError> {
    mut failures: i64 = 0;
    mut report: String = String::new();
    for (mut i: i64 = 0; i < CASE_COUNT; i++) {
        const case: Case = CASES[i];
        const pattern: Str = Str::new(case.pattern);
        const haystack: Str = Str::new(case.haystack);
        match (Regex::new(pattern)) {
            Result::Err(error) => {
                failures = failures + 1;
                if (failures <= 20) {
                    report.push(f"\n  #{i} {pattern:?}: refused: {error.describe()}");
                }
            }
            Result::Ok(expression) => {
                // The answer in the generator's notation: `none`, or each
                // group's `start-end` (`-` for a group that did not take
                // part), space-separated.
                mut got: String = String::new();
                match (expression.captures(haystack)) {
                    Option::None => { got.push(Str::new("none")); }
                    Option::Some(captures) => {
                        for (mut group: i64 = 0; group < captures.length(); group++) {
                            if (group > 0) { got.push_byte(0x20); }
                            match (captures.get(group)) {
                                Option::Some(span) => {
                                    got.push(span.start());
                                    got.push_byte(0x2D);
                                    got.push(span.end());
                                }
                                Option::None => { got.push_byte(0x2D); }
                            }
                        }
                    }
                }
                // A `~` in the expected answer is any span (see the
                // generator on why such spans go unchecked).
                mut wanted = Str::new(case.expected).split(&Str::new(" "));
                mut actual = got.as_str().split(&Str::new(" "));
                mut agrees: boolean = true;
                loop {
                    const expected_token: Option<Str> = wanted.next();
                    const actual_token: Option<Str> = actual.next();
                    if (expected_token.is_none() || actual_token.is_none()) {
                        agrees = expected_token.is_none() && actual_token.is_none();
                        break;
                    }
                    const token: Str = expected_token.unwrap();
                    if (token != Str::new("~") && token != actual_token.unwrap()) {
                        agrees = false;
                        break;
                    }
                }
                if (!agrees) {
                    failures = failures + 1;
                    if (failures <= 20) {
                        report.push(f"\n  #{i} {pattern:?} on {haystack:?}: expected {case.expected}, got {got.as_str()}");
                    }
                }
            }
        }
    }
    if (failures > 0) {
        mut message: String = String::new();
        message.push(f"{failures} of {CASE_COUNT} cases differ:");
        message.push(report.as_str());
        return bail(message.as_str());
    }
    return Result::Ok(());
}
