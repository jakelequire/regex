///! The byte API: haystacks that are not UTF-8, and Unicode mode off.

![config(testing)]
namespace RegexTests::Bytes;

import std::core::slice::{ Slice };
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::test::assert::{ expect, expect_equal };
import std::test::error::{ TestError };
import regex::bytes::{ Regex, RegexBuilder, Match, Captures };

![test]
function invalid_utf8_haystacks_are_searched() -> Result<(), TestError> {
    mut raw: [u8; 6] = [0x61, 0xFF, 0x62, 0xC3, 0x28, 0x63];
    const haystack: &Slice<u8> = Slice::from_raw(&raw[0], 6);
    const expression: Regex = Regex::new(Str::new("[a-c]")).unwrap();
    mut count: i64 = 0;
    for (found in expression.find_all(haystack)) { count = count + 1; }
    expect_equal(count, 3 as i64)?;
    // Unicode `.` reads scalars and never matches a malformed byte.
    const dot: Regex = Regex::new(Str::new("a.b")).unwrap();
    return expect(!dot.is_match(haystack), "a malformed byte is no scalar");
}

![test]
function unicode_off_reads_single_bytes() -> Result<(), TestError> {
    mut raw: [u8; 4] = [0x61, 0xFF, 0xFE, 0x62];
    const haystack: &Slice<u8> = Slice::from_raw(&raw[0], 4);
    const any: Regex = Regex::new(Str::new("(?-u)a..b")).unwrap();
    expect(any.is_match(haystack), "(?-u). matches any byte")?;
    const exact: Regex = Regex::new(Str::new("(?-u)\\xFF\\xFE")).unwrap();
    const found: Match = exact.find(haystack).unwrap();
    expect_equal(found.start(), 1 as i64)?;
    expect_equal(found.end(), 3 as i64)?;
    const high: Regex = Regex::new(Str::new("(?-u)[\\x80-\\xFF]+")).unwrap();
    return expect_equal(high.find(haystack).unwrap().length(), 2 as i64);
}

![test]
function unicode_on_matches_utf8_in_bytes() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("\\p{Greek}+")).unwrap();
    const found: Match = expression.find(Str::new("ab \u{3b1}\u{3b2}").as_bytes()).unwrap();
    expect_equal(found.start(), 3 as i64)?;
    return expect_equal(found.end(), 7 as i64);
}

![test]
function empty_matches_advance_one_byte() -> Result<(), TestError> {
    // Unlike a text regex, a byte regex may match between the bytes of a
    // scalar.
    const expression: Regex = Regex::new(Str::new("")).unwrap();
    mut count: i64 = 0;
    for (found in expression.find_all(Str::new("\u{e9}").as_bytes())) { count = count + 1; }
    return expect_equal(count, 3 as i64);
}

![test]
function replace_and_captures_over_bytes() -> Result<(), TestError> {
    const expression: Regex = Regex::new(Str::new("(?<key>\\w+)=(\\w+)")).unwrap();
    const replaced: Array<u8> = expression.replace_all(Str::new("a=1;b=2").as_bytes(), Str::new("$2=${key}"));
    expect(Str::from(replaced.as_slice()) == Str::new("1=a;2=b"), "replace_all")?;
    const captures: Captures = expression.captures(Str::new("x=9").as_bytes()).unwrap();
    expect(Str::from(captures.name(Str::new("key")).unwrap().as_bytes()) == Str::new("x"), "named group")?;
    mut pieces: i64 = 0;
    for (piece in Regex::new(Str::new(";")).unwrap().split(Str::new("a;b;c").as_bytes())) { pieces = pieces + 1; }
    return expect_equal(pieces, 3 as i64);
}

![test]
function builder_options_apply() -> Result<(), TestError> {
    const expression: Regex = RegexBuilder::new(Str::new("ABC")).case_insensitive(true).build().unwrap();
    return expect(expression.is_match(Str::new("xabcx").as_bytes()), "case_insensitive");
}
